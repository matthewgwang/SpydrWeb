# ============================================================
# SENTINEL — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Configuration ---
# GPT-OSS 120B — get the endpoint URL from the hackathon Discord/docs
LLM_BASE_URL=https://your-llm-endpoint-here/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-here

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=http://localhost:5173

# --- Demo ---
DEMO_SPEED=0.5
CACHE_LLM_RESPONSES=true
DATA_MODE=synthetic          # "synthetic" | "paysim" | "both"

# --- Detection Thresholds ---
FAST_PATH_MAX_AMOUNT_STD=2.0
FAST_PATH_MIN_PROFILE_AGE_DAYS=30
SCORE_THRESHOLD_ALLOW=0.3
SCORE_THRESHOLD_CHALLENGE=0.6
SCORE_THRESHOLD_BLOCK=0.85
VELOCITY_MULTIPLIER_WEIGHT=0.15
CORROBORATION_BONUS=0.1

# --- Orchestrator ---
DEFAULT_MODE=pipeline        # "pipeline" | "agentic"
MAX_AGENT_ROUNDS=12
